<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <header class="app-header">
      <h1>Members Only Clubhouse</h1>
    </header>

    <div class="nav-banner">
      <% if (currentUser) { %>
        <div class="user-info">
          <div>Logged in as <strong><%= currentUser.first_name %> <%= currentUser.last_name %></strong></div>
          <div class="badges">
            <% if (currentUser.membership_status) { %>
              <span class="badge badge-member">🌟 Club Member</span>
            <% } else { %>
              <span class="badge badge-nonmember">👤 Non-Member</span>
            <% } %>
            <% if (currentUser.is_admin) { %>
              <span class="badge badge-admin">🔑 Admin</span>
            <% } %>
          </div>
        </div>

        <div class="nav-links">
          <a href="/create-message" class="btn-link">+ Post Message</a>
          <% if (!currentUser.membership_status) { %>
            <a href="/join-club" class="btn-link">Enter Secret Code</a>
          <% } %>
          <% if (!currentUser.is_admin) { %>
            <a href="/join-admin" class="btn-link">Become Admin</a>
          <% } %>
          <a href="/logout" class="btn-link" style="color: #ef4444; margin-left: auto;">Log Out</a>
        </div>
      <% } else { %>
        <p>Welcome! Log in or sign up to see member posts and reveal message authors.</p>
        <div class="nav-links">
          <a href="/log-in" class="btn-link">Log In</a>
          <a href="/sign-up" class="btn-link">Sign Up</a>
        </div>
      <% } %>
    </div>

    <h2 class="feed-header">Clubhouse Feed</h2>

    <% if (messages.length > 0) { %>
      <% messages.forEach(message => { %>
        <div class="msg-card">
          <h3><%= message.title %></h3>
          <p><%= message.text %></p>
          
          <div class="msg-meta">
            <% if (currentUser && currentUser.membership_status) { %>
              <span class="meta-revealed">
                <strong><%= message.first_name %> <%= message.last_name %></strong> • <%= new Date(message.timestamp).toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
              </span>
            <% } else { %>
              <span class="meta-hidden">🔒 Author & date hidden (Join club to reveal)</span>
            <% } %>

            <% if (currentUser && currentUser.is_admin) { %>
              <form action="/message/<%= message.id %>/delete" method="POST" style="margin: 0;">
                <button type="submit" class="btn-delete" onclick="return confirm('Delete this post?');">Delete</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <div class="msg-card">
        <p style="text-align: center; color: var(--text-muted);">No messages yet. Be the first to post!</p>
      </div>
    <% } %>
  </div>
</body>
</html>